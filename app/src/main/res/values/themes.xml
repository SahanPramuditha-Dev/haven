<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HAVEN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/haven_bg</item>
        <item name="android:navigationBarColor">@color/haven_bg</item>
        <item name="android:statusBarColor">@color/haven_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/haven_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_haven_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.HAVEN</item>
    </style>
</resources>