# HAVEN Backend Configuration
PROJECT_NAME="HAVEN Family OS API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & CORS
SECRET_KEY="dev-insecure-secret-key-replace-in-prod"
ALLOWED_ORIGINS="*"

# Database (PostgreSQL)
# Local development or test database URL:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/haven_db"

# Firebase Credentials
FIREBASE_PROJECT_ID="haven-family-os"
# Optional path to service account JSON:
FIREBASE_CREDENTIALS_PATH=""
# Allow mock/test tokens in development:
ALLOW_DEV_TEST_AUTH=True

# Cloudflare R2 / S3 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="haven-media"
R2_PUBLIC_DOMAIN=""
